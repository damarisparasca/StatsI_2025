y <- c(105, 69, 86, 100, 82, 111, 104, 110, 87, 108, 87, 90, 94, 113, 112, 98, 80, 97, 95, 111, 114, 89, 95, 126, 98)

sum(y)
mean = sum(y)/length(y)
mean

# confidence interval
demeanedSum <- y - mean
sum(demeanedSum)
squaredError <- demeanedSum ^ 2 
sum(squaredError)
variance <- sum(squaredError)/(length(y)-1)
variance
stdev = sqrt(variance)
stdev
sterror = stdev/sqrt(length(y))
sterror
t = qt(p = 0.1/2, df = 24, lower.tail = F)
t 
lowerlimit = mean - t * sterror
upperlimit = mean + t * sterror
lowerlimit
upperlimit

# hypothesis testing 
# assumptions
# null hypothesis mean is lower or equal to 100 
ts = (mean - 100)/sterror
ts 
p = pt(abs(ts), df = 24, lower.tail = FALSE)
p
# cant reject the null hypothesis 



expenditure <- read.csv("https://raw.githubusercontent.com/kosukeimai/qss/master/PREDICTION/women.csv", header=T)
head(expenditure)
ggplot(expenditure, aes(x = reserved, y = irrigation)) +#
  geom_point() +#
  labs(title = "Relationship between personal income #
  				and housing assistance expenditure",#
       x = "personal income (USD per capita)",#
       y = "expenditure on housing assistance (USD per capita)") +#
  stat_cor(aes(label = ..r.label..)) +#
  theme_minimal()
lapply(c("ggplot2"), pkgTest)
